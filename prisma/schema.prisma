// SolarOS Enterprise Backend - Prisma Schema
// Single Source of Truth for Database Models

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ----------------------------------------------------------------------------
// 1. Roles & RBAC Capabilities
// ----------------------------------------------------------------------------

model Role {
  id          String    @id @db.VarChar(50) // e.g. 'owner_admin', 'sales_exec'
  name        String    @db.VarChar(100)
  description String?   @db.Text
  permissions Json      @default("[]") // Array of capability permissions
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")

  profiles    Profile[]
  employees   Employee[]

  @@map("roles")
}

// ----------------------------------------------------------------------------
// 2. User Profiles & Authentication
// ----------------------------------------------------------------------------

model Profile {
  id             String    @id @default(uuid()) @db.Uuid
  authUserId     String?   @unique @map("auth_user_id") @db.Uuid
  fullName       String    @map("full_name") @db.VarChar(150)
  email          String    @unique @db.VarChar(255)
  phone          String?   @db.VarChar(30)
  passwordHash   String    @map("password_hash") @db.VarChar(255)
  roleId         String    @map("role_id") @db.VarChar(50)
  roleTitle      String?   @map("role_title") @db.VarChar(100)
  department     String?   @db.VarChar(100)
  avatarUrl      String?   @map("avatar_url") @db.Text
  isActive       Boolean   @default(true) @map("is_active")
  emailVerified  Boolean   @default(false) @map("email_verified")
  lastLoginAt    DateTime? @map("last_login_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")

  role           Role      @relation(fields: [roleId], references: [id])
  employee       Employee?
  sessions       Session[]
  passwordResets PasswordResetToken[]
  auditLogs      AuditLog[]

  @@index([email])
  @@index([roleId])
  @@map("profiles")
}

// ----------------------------------------------------------------------------
// 3. Employees & Workforce
// ----------------------------------------------------------------------------

model Employee {
  id                  String    @id @default(uuid()) @db.Uuid
  profileId           String?   @unique @map("profile_id") @db.Uuid
  employeeCode        String    @unique @map("employee_code") @db.VarChar(30)
  firstName           String    @map("first_name") @db.VarChar(100)
  lastName            String    @map("last_name") @db.VarChar(100)
  email               String    @db.VarChar(255)
  phone               String    @db.VarChar(30)
  department          String    @db.VarChar(50)
  designation         String    @db.VarChar(100)
  roleId              String    @map("role_id") @db.VarChar(50)
  hourlyRate          Decimal?  @default(0.00) @map("hourly_rate") @db.Decimal(10, 2)
  isAvailable         Boolean   @default(true) @map("is_available")
  currentAssignedJobs Int       @default(0) @map("current_assigned_jobs")
  hireDate            DateTime  @default(now()) @map("hire_date") @db.Date
  createdAt           DateTime  @default(now()) @map("created_at")

  profile             Profile?  @relation(fields: [profileId], references: [id], onDelete: SetNull)
  role                Role      @relation(fields: [roleId], references: [id])
  delegations         OperationalDelegation[]

  @@index([employeeCode])
  @@index([department])
  @@index([email])
  @@index([firstName, lastName])
  @@map("employees")
}

// ----------------------------------------------------------------------------
// 4. Operational Delegations & Exception Governance
// ----------------------------------------------------------------------------

model OperationalDelegation {
  id                String    @id @default(uuid()) @db.Uuid
  delegationCode    String    @unique @map("delegation_code") @db.VarChar(30)
  employeeId        String    @map("employee_id") @db.Uuid
  employeeName      String    @map("employee_name") @db.VarChar(150)
  grantedPermission String    @map("granted_permission") @db.VarChar(100)
  departmentScope   String    @map("department_scope") @db.VarChar(50)
  resourceId        String?   @map("resource_id") @db.VarChar(50)
  authorizedBy      String    @map("authorized_by") @db.VarChar(150)
  justification     String    @db.Text
  effectiveFrom     DateTime  @default(now()) @map("effective_from") @db.Date
  effectiveTo       DateTime  @map("effective_to") @db.Date
  active            Boolean   @default(true)
  createdAt         DateTime  @default(now()) @map("created_at")

  employee          Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, active])
  @@index([grantedPermission])
  @@map("operational_delegations")
}

// ----------------------------------------------------------------------------
// 5. Sessions & Refresh Token Lifecycle
// ----------------------------------------------------------------------------

model Session {
  id           String    @id @default(uuid()) @db.Uuid
  profileId    String    @map("profile_id") @db.Uuid
  refreshToken String    @unique @map("refresh_token") @db.VarChar(255)
  userAgent    String?   @map("user_agent") @db.Text
  ipAddress    String?   @map("ip_address") @db.VarChar(45)
  isRevoked    Boolean   @default(false) @map("is_revoked")
  expiresAt    DateTime  @map("expires_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at")

  profile      Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, isRevoked])
  @@index([refreshToken])
  @@map("sessions")
}

// ----------------------------------------------------------------------------
// 6. Password Reset & Verification Tokens
// ----------------------------------------------------------------------------

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  profileId String    @map("profile_id") @db.Uuid
  token     String    @unique @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  used      Boolean   @default(false)
  createdAt DateTime  @default(now()) @map("created_at")

  profile   Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([token, used])
  @@map("password_reset_tokens")
}

// ----------------------------------------------------------------------------
// 7. Audit Logging
// ----------------------------------------------------------------------------

model AuditLog {
  id             String    @id @default(uuid()) @db.Uuid
  actorId        String?   @map("actor_id") @db.Uuid
  actorName      String    @map("actor_name") @db.VarChar(150)
  actorRole      String    @map("actor_role") @db.VarChar(50)
  permissionUsed String?   @map("permission_used") @db.VarChar(100)
  action         String    @db.VarChar(100) // e.g. 'AUTH_LOGIN', 'SURVEY_ASSIGN', 'DELEGATION_CREATE'
  entity         String    @db.VarChar(50)  // e.g. 'Session', 'Survey', 'Installation'
  entityId       String?   @map("entity_id") @db.VarChar(50)
  previousState  Json?     @map("previous_state")
  newState       Json?     @map("new_state")
  reason         String?   @db.Text
  ipAddress      String?   @map("ip_address") @db.VarChar(45)
  timestamp      DateTime  @default(now())

  profile        Profile?  @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entity, entityId])
  @@index([action])
  @@index([timestamp])
  @@map("audit_logs")
}

// ----------------------------------------------------------------------------
// 8. Financial Transactions & Direct Project Expenses
// ----------------------------------------------------------------------------

model FinancialTransaction {
  id                String   @id @default(uuid()) @db.Uuid
  transactionNumber String   @unique @map("transaction_number") @db.VarChar(50)
  projectId         String?  @map("project_id") @db.VarChar(50)
  projectCode       String?  @map("project_code") @db.VarChar(50)
  orderId           String?  @map("order_id") @db.VarChar(50)
  orderNumber       String?  @map("order_number") @db.VarChar(50)
  customerId        String?  @map("customer_id") @db.VarChar(50)
  customerName      String   @map("customer_name") @db.VarChar(150)
  type              String   @db.VarChar(50)
  category          String   @db.VarChar(100)
  amount            Decimal  @db.Decimal(12, 2)
  date              DateTime @db.Date
  sourceModule      String   @map("source_module") @db.VarChar(50)
  sourceRecordId    String   @map("source_record_id") @db.VarChar(50)
  referenceNumber   String?  @map("reference_number") @db.VarChar(100)
  paymentMethod     String?  @map("payment_method") @db.VarChar(50)
  status            String   @default("verified") @db.VarChar(30)
  createdBy         String   @map("created_by") @db.VarChar(150)
  notes             String?  @db.Text
  documentUrl       String?  @map("document_url") @db.Text
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([projectId])
  @@index([orderId])
  @@index([type])
  @@index([date])
  @@map("financial_transactions")
}

model DirectExpense {
  id               String   @id @default(uuid()) @db.Uuid
  expenseNumber    String   @unique @map("expense_number") @db.VarChar(50)
  projectId        String?  @map("project_id") @db.VarChar(50)
  projectCode      String?  @map("project_code") @db.VarChar(50)
  orderId          String?  @map("order_id") @db.VarChar(50)
  orderNumber      String?  @map("order_number") @db.VarChar(50)
  customerName     String?  @map("customer_name") @db.VarChar(150)
  isCompanyLevel   Boolean  @default(false) @map("is_company_level")
  category         String   @db.VarChar(100)
  amount           Decimal  @db.Decimal(12, 2)
  vendor           String   @db.VarChar(150)
  expenseDate      DateTime @map("expense_date") @db.Date
  paymentMethod    String   @map("payment_method") @db.VarChar(50)
  paymentStatus    String   @default("paid") @map("payment_status") @db.VarChar(30)
  approvalStatus   String   @default("approved") @map("approval_status") @db.VarChar(30)
  invoiceReference String?  @map("invoice_reference") @db.VarChar(100)
  description      String   @db.Text
  receiptUrl       String?  @map("receipt_url") @db.Text
  receiptFileName  String?  @map("receipt_file_name") @db.VarChar(255)
  recordedBy       String   @map("recorded_by") @db.VarChar(150)
  recordedAt       DateTime @default(now()) @map("recorded_at")

  @@index([projectId])
  @@index([orderId])
  @@index([category])
  @@index([expenseDate])
  @@map("direct_expenses")
}

model SiteSurvey {
  id                        String    @id @default(uuid()) @db.Uuid
  surveyNumber              String    @unique @map("survey_number") @db.VarChar(50)
  customerId                String    @map("customer_id") @db.VarChar(50)
  customerName              String    @map("customer_name") @db.VarChar(150)
  customerPhone             String    @map("customer_phone") @db.VarChar(50)
  customerAddress           String    @map("customer_address") @db.Text
  scheduledDate             DateTime  @map("scheduled_date")
  status                    String    @default("scheduled") @db.VarChar(30)
  reviewStatus              String    @default("draft") @map("review_status") @db.VarChar(50)
  approvalStatus            String    @default("pending_assignment") @map("approval_status") @db.VarChar(50)
  technicianId              String?   @map("technician_id") @db.VarChar(50)
  technicianName            String?   @map("technician_name") @db.VarChar(150)
  assignedReviewerId        String?   @map("assigned_reviewer_id") @db.VarChar(50)
  assignedReviewerName      String?   @map("assigned_reviewer_name") @db.VarChar(150)
  assignedApproverId        String?   @map("assigned_approver_id") @db.VarChar(50)
  assignedApproverName      String?   @map("assigned_approver_name") @db.VarChar(150)
  reviewedById              String?   @map("reviewed_by_id") @db.VarChar(50)
  reviewedByName            String?   @map("reviewed_by_name") @db.VarChar(150)
  reviewedAt                DateTime? @map("reviewed_at")
  reviewNotes               String?   @map("review_notes") @db.Text
  reviewRecommendation      String?   @map("review_recommendation") @db.VarChar(50)
  approvedById              String?   @map("approved_by_id") @db.VarChar(50)
  approvedByName            String?   @map("approved_by_name") @db.VarChar(150)
  approvedAt                DateTime? @map("approved_at")
  approvalNotes             String?   @map("approval_notes") @db.Text
  correctionsRequestedNotes String?   @map("corrections_requested_notes") @db.Text
  rejectionReason           String?   @map("rejection_reason") @db.Text
  reportVersion             Int       @default(1) @map("report_version")
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @default(now()) @map("updated_at")

  @@index([customerId])
  @@index([status])
  @@index([reviewStatus])
  @@index([approvalStatus])
  @@map("site_surveys")
}

model SurveyWorkflowAudit {
  id             String   @id @default(uuid()) @db.Uuid
  surveyId       String   @map("survey_id") @db.VarChar(50)
  surveyNumber   String   @map("survey_number") @db.VarChar(50)
  eventType      String   @map("event_type") @db.VarChar(50)
  actorId        String   @map("actor_id") @db.VarChar(50)
  actorName      String   @map("actor_name") @db.VarChar(150)
  actorRole      String   @map("actor_role") @db.VarChar(50)
  timestamp      DateTime @default(now())
  previousStatus String?  @map("previous_status") @db.VarChar(50)
  newStatus      String   @map("new_status") @db.VarChar(50)
  comments       String?  @db.Text
  version        Int      @default(1)

  @@index([surveyId])
  @@index([eventType])
  @@map("survey_workflow_audits")
}
