DATABASE_URL=postgresql://postgres.project-ref:password@host:6543/postgres
NODE_ENV=development
PORT=5000
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=30d
COOKIE_SECRET=replace-with-a-random-cookie-secret
CLIENT_ORIGIN=http://localhost:5173
SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_ANON_KEY=replace-with-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
SUPABASE_JWKS_URL=https://project-ref.supabase.co/auth/v1/.well-known/jwks.json

# Optional. No built-in development or seed password exists.
# DEV_FALLBACK_PASSWORD=replace-with-a-strong-dev-only-password
# SEED_ADMIN_PASSWORD=replace-with-a-strong-seed-password

# FastAPI demo backend (backend/main.py)
# JWT_SECRET=replace-with-at-least-32-random-characters
# DEMO_USER_PASSWORD=replace-with-a-strong-demo-password
# CORS_ORIGINS=http://localhost:5173
# ENVIRONMENT=development
